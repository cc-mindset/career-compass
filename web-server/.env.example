
PORT=#your backend port
MONGODB_URI=#your mongodb connection string
OPENAI_API_KEY=#your openai api key
PINECONE_API_KEY=#your pinecone api key

# ── OpenAI Rate Limit Protection ──────────────────────────────────────────────
# Check your plan limits at: https://platform.openai.com/settings/organization/limits
OPENAI_RPM_LIMIT=500        # Requests per minute ceiling 
OPENAI_TPM_LIMIT=150000     # Tokens per minute ceiling 
OPENAI_SAFETY_RATIO=0.8     # Block at 80% of limit 
OPENAI_MAX_CONCURRENT=3     # Max simultaneous OpenAI section calls per job
OPENAI_MONTHLY_TOKEN_LIMIT=0  # Monthly token ceiling (0 = unlimited); in-memory only until DB is wired
INSIGHTS_CACHE_TTL_HOURS=24
